{
	"name": "ch5-svelte",
	"description": "Crestron CH5 signals as Svelte 5 runes. Uses MicroComLib by default, or bring your own CrComLib.",
	"version": "2.0.0-beta.0",
	"license": "Apache-2.0",
	"keywords": [
		"crestron",
		"ch5",
		"crcomlib",
		"microcomlib",
		"svelte",
		"svelte5",
		"runes"
	],
	"repository": "github:M3-Technology-Group/ch5-svelte",
	"homepage": "https://m3-technology-group.github.io/ch5-svelte/",
	"packageManager": "pnpm@11.21.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "pnpm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "vitest run",
		"docs": "typedoc"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"publishConfig": {
		"tag": "beta"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"microcomlib": "^0.1.0"
	},
	"devDependencies": {
		"@crestron/ch5-crcomlib": "^2.11.1",
		"@crestron/ch5-webxpanel": "^2.8.0",
		"@eslint/compat": "^1.2.3",
		"@eslint/js": "^9.17.0",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^15.0.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.2.6",
		"publint": "^0.2.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typedoc": "^0.27.6",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^5.4.11",
		"vitest": "^2.0.4"
	}
}
